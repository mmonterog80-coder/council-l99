# Council L99 - Environment Configuration Example
# Note: .env files are not loaded automatically by default.
# PowerShell: $env:VARIABLE_NAME="value"
# Linux/macOS: export VARIABLE_NAME="value"

# Local Ollama Inference (Default: 100% Local on GPU)
OLLAMA_API_URL=http://127.0.0.1:11434/api/generate
OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embed
EMBED_MODEL=nomic-embed-text:latest

# Optional Cloud Oracle for Secondary Code Synthesis
# If unset, the system falls back entirely to local Ollama models
# DEEPSEEK_API_KEY=your_optional_deepseek_api_key_here
